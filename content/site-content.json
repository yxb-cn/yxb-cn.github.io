  "researchTopics": [
    {
      "number": "01",
      "title": "Predictability in Financial Markets",
      "text": "I study when financial returns and macroeconomic variables are predictable, with particular attention to real-time information, forecast evaluation, and economic value."
    },
    {
      "number": "02",
      "title": "High-Dimensional Factor Models",
      "text": "I develop estimation and inference for latent-factor and factor-augmented models when predictors are numerous, persistent, or weakly informative."
    },
    {
      "number": "03",
      "title": "Time-Varying Econometrics",
      "text": "I examine models whose coefficients change over time and use sieve and kernel methods to distinguish gradual evolution from abrupt structural change."
    },
    {
      "number": "04",
      "title": "Interpretable Machine Learning",
      "text": "I design machine-learning methods that preserve economic structure while improving predictive accuracy and robustness."
    },
    {
      "number": "05",
      "title": "Forecast Combination",
      "text": "I study how multiple models and data sources can be combined under uncertainty, instability, and limited samples."
    }
  ],
